rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction helper pour vérifier si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fonction helper pour vérifier si l'utilisateur accède à ses propres données
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if the user has the admin role
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Global Admin Rule: Admins can do anything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Collection Users
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read, list, delete: if isAdmin(); // PERMISSION ADMIN EXPLICITE
      
      // Bénéficiaires en tant que sous-collection
      match /beneficiaries/{beneficiaryId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Collection KYC
    match /kyc/{kycId} {
      allow read, write: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Collection Wallets - FIX POUR VIREMENTS ENTRE CLIENTS
    match /wallets/{walletId} {
      // Lecture: Permissif pour permettre les virements internes
      // Tout utilisateur authentifié peut LIRE les wallets (nécessaire pour vérifier IBAN du destinataire)
      allow read: if isAuthenticated();
      
      // Création: seulement pour soi-même
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Update: Permissif pour virements internes entre clients
      allow update: if isAuthenticated();
    }

    // Collection Cards (Cartes Bancaires)
    match /cards/{cardId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Collection RIBs
    match /ribs/{ribId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Collection Transactions
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated();
    }

    // Collection Loans (Demandes de Crédit)
    match /loans/{loanId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Collection Card Requests (Demandes de Cartes Physiques)
    match /card_requests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Collection Account Requests (Demandes d'ouverture de comptes)
    match /account_requests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Collection Invoices (Factures)
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
    }

    // Loan Leads (Public Leads)
    match /loan_leads/{leadId} {
      allow create: if true;
    }

    // Contact Messages (Public)
    match /contact_messages/{messageId} {
      allow create: if true;
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      // Creation accessible à tous les authentifiés (client)
      allow create: if isAuthenticated();
      
      // Admin: Accès total
      // Client: Accès si propriétaire
      allow read, update, delete: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      
      match /messages/{messageId} {
        // Admin: Accès total
        // Client: Accès si propriétaire du ticket parent
        allow read, create: if isAdmin() || (isAuthenticated() && 
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid);
      }
    }

    // System Settings (Public Read)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}